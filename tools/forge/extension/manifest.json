{
  "manifest_version": 3,
  "name": "교재 공방 Flow Bridge",
  "version": "0.5.0",
  "description": "교재 공방(로컬 서버, 포트 8766)의 자동 대기열을 Google Flow에서 생성해 돌려보낸다. 캐릭터 공방 Flow Bridge(StudioForge Flow Bridge 0.4.4 포크)와 같음.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://labs.google/fx/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://*.flow-content.google/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://assets.grok.com/*",
    "https://imagine-public.x.ai/*",
    "https://*.lovable.app/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "https://*.supabase.co/*",
    "https://jmwxgevvuerulfwgdtmn.supabase.co/*",
    "https://*.googleusercontent.com/*",
    "https://*.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "blob:*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StudioForge Flow Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://grok.com/imagine*",
        "https://grok.com/?*",
        "https://grok.com/"
      ],
      "js": [
        "grok-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/imagine*",
        "https://grok.com/?*",
        "https://grok.com/"
      ],
      "js": [
        "grok-injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.lovable.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}