    "panels": [
      {
        "id": "scene_b2_u03_1",
        "desc": "The bank of the Word Pond is full of flapping brown hens with red combs — ten of them — running in every direction with feathers flying. A butterfly net with a wooden handle lies on the sand; high above, a white jet plane draws a vapor trail across the sky. Bun points at the net; Pip, trying to say the word, has shouted it backwards and now stares at all the hens that came running; Hedgie covers his head; Beads peeks from a lily pad. Hidden in the picture: the net, a hen, ten hens, the jet. Grumble does NOT appear.",
        "hidden": [
          "net",
          "hen",
          "ten",
          "jet"
        ],
        "lines": [
          {
            "who": "bun",
            "text": "I see a net.",
            "audio": "b2_u03_l1",
            "ko": "그물이 보여."
          },
          {
            "who": "pip",
            "text": "Ten! Ten?",
            "audio": "b2_u03_l2",
            "ko": "텐! 텐?"
          },
          {
            "who": "narrator",
            "text": "Ten hens! Oh no!",
            "audio": "b2_u03_l3",
            "ko": "암탉 열 마리! 어떡해!"
          }
        ],
        "video": "vid_b2_u03_1",
        "ko": "암탉 열 마리가 뛰어다녀요. 그물이 모래에 있고 하늘에 제트기! 핍이 \"텐!\" 하자 암탉이 더 와요.",
        "ask": [
          {
            "en": "How many hens?",
            "ko": "암탉이 몇 마리야?"
          },
          {
            "en": "What is in the sky?",
            "ko": "하늘에 뭐가 있어?"
          }
        ]
      },
      {
        "id": "scene_b2_u03_2",
        "desc": "Beads threads n-e-t and the butterfly net sinks into the water and rises as a wide flat stepping stone with a net pattern on it; the ten hens hop onto it in a crowd, clucking happily. On the bank an orange goldfish swims in a round glass bowl, and a dripping wet brown puppy shakes off water drops next to it, splashing Hedgie. Bun laughs; Pip glows. Hidden in the picture: the net stone, the goldfish bowl, the wet puppy, the ten hens. Grumble does NOT appear.",
        "hidden": [
          "net",
          "pet",
          "wet",
          "ten"
        ],
        "lines": [
          {
            "who": "beads",
            "text": "/n/ /e/ /t/ net!",
