    "panels": [
      {
        "id": "scene_b2_u07_1",
        "desc": "A cold windy morning on the stepping stones, leaves flying. Hedgie wears a red jacket whose zipper is stuck halfway up; he tugs the zipper tab with both paws and — rip! — a jagged tear opens in the sleeve, with a scrap of torn paper from his pocket flying away. Bun shivers with her ears wrapped around her; Pip tries to say the word but says it backwards, feathers ruffled; Beads huddles in a bead-ball. Hidden in the picture: the zipper on the jacket, the rip. Grumble does NOT appear.",
        "hidden": [
          "zip",
          "rip"
        ],
