  "story": {
    "title": "Zip It Up!",
    "bgm": "bgm_bright",
    "panels": [
      {
        "id": "scene_b2_u07_1",
        "desc": "A cold windy morning on the stepping stones, leaves flying. Hedgie wears a red jacket whose zipper is stuck halfway up; he tugs the zipper tab with both paws and — rip! — a jagged tear opens in the sleeve, with a scrap of torn paper from his pocket flying away. Bun shivers with her ears wrapped around her; Pip tries to say the word but says it backwards, feathers ruffled; Beads huddles in a bead-ball. Hidden in the picture: the zipper on the jacket, the rip. Grumble does NOT appear.",
        "hidden": [
          "zip",
          "rip"
        ],
        "lines": [
          {
            "who": "hedgie",
            "text": "Zip it up!",
            "audio": "b2_u07_l1",
            "ko": "지퍼 올려!"
          },
          {
            "who": "narrator",
            "text": "Rip! Oh no!",
            "audio": "b2_u07_l2",
            "ko": "쭉! 어떡해!"
          },
          {
            "who": "pip",
            "text": "Piz! Piz?",
            "audio": "b2_u07_l3",
            "ko": "피즈! 피즈?"
          }
        ],
        "video": "vid_b2_u07_1",
        "ko": "바람이 차요. 헤지 지퍼가 걸려서 당기다 쭉! 찢어졌어요. 핍은 \"피즈!\"",
        "ask": [
          {
            "en": "What is wrong with the jacket?",
            "ko": "재킷이 어떻게 됐어?"
          },
          {
            "en": "Is it warm or cold?",
            "ko": "따뜻해, 추워?"
          }
        ]
      },
      {
        "id": "scene_b2_u07_2",
        "desc": "Beads threads z-i-p: the zipper on Hedgie's jacket zips itself up with a zing and a new stepping stone rises beside him. The friends have a picnic on a big flat stone: Bun dips a potato chip into a bowl of creamy dip and has a big blob of dip on her lip; Pip laughs; Hedgie pats his zipped-up jacket happily. Hidden in the picture: the zipper, the bowl of dip, Bun's lip. Grumble does NOT appear.",
        "hidden": [
          "zip",
          "dip",
          "lip"
        ],
        "lines": [
          {
            "who": "beads",
            "text": "/z/ /ɪ/ /p/ zip!",
            "audio": "blend_zip",
            "pop": "zip",
            "ko": "/z/ /ɪ/ /p/ 지퍼 올리기!"
          },
          {
            "who": "hedgie",
            "text": "Zip! It is up!",
            "audio": "b2_u07_l4",
            "ko": "지퍼! 올라갔어!"
          },
          {
            "who": "bun",
            "text": "Dip is on my lip!",
            "audio": "b2_u07_l5",
            "ko": "내 입술에 소스가 묻었어!"
          }
        ],
        "ko": "z-i-p! 지퍼가 저절로 올라가요. 소풍이에요. 번 입술에 소스가 묻었어요.",
        "ask": [
          {
            "en": "What is on Bun's lip?",
            "ko": "번 입술에 뭐가 묻었어?"
          },
          {
            "en": "Is the zipper up now?",
            "ko": "지퍼가 올라갔어?"
          }
        ]
      },
      {
        "id": "scene_b2_u07_3",
        "desc": "The orange cat sits on top of an open white first-aid kit on a stepping stone; Bun swings a wooden baseball bat and hits a peach pit far out over the pond with motion lines and a splash; Hedgie covers his ears; Beads threads s-i-t. In the reeds, Grumble covers both ears with his paws at the noise, his lantern glowing at his feet. Hidden in the picture: the sitting cat, the kit, the bat hitting the pit, the peach pit.",
        "hidden": [
          "sit",
          "kit",
          "hit",
          "pit"
        ],
        "lines": [
          {
            "who": "beads",
            "text": "/s/ /ɪ/ /t/ sit!",
            "audio": "blend_sit",
            "pop": "sit",
            "ko": "/s/ /ɪ/ /t/ 앉다!"
          },
          {
            "who": "bun",
            "text": "Sit, cat, sit!",
            "audio": "b2_u07_l6",
            "ko": "앉아, 고양이야, 앉아!"
          },
          {
            "who": "hedgie",
            "text": "Hit the pit! Hit it!",
            "audio": "b2_u07_l7",
            "ko": "씨를 쳐! 쳐 봐!"
          }
        ],
        "video": "vid_b2_u07_2",
        "ko": "고양이가 구급상자 위에 앉았어요. 번이 방망이로 복숭아씨를 쳐서 풍덩! 그럼블은 귀를 막아요.",
        "ask": [
          {
            "en": "Where does the cat sit?",
            "ko": "고양이는 어디에 앉았어?"
          },
          {
            "en": "What does Bun hit?",
            "ko": "번이 뭘 쳤어?"
          }
        ]
      },
      {
        "id": "scene_b2_u07_4",
        "desc": "Everyone sits in a row on the new -ip and -it stepping stones with their feet in the water: Bun, Hedgie with the first-aid kit on his lap, the cat, Beads, and Pip, who finally says the word the right way and glows. At the end of the row Grumble has come out of the reeds and sits down shyly on the last stone with his lantern beside him — the first time he sits with the friends. Hidden in the picture: the kit, the sitting cat, the zipped jacket.",
        "hidden": [
          "kit",
          "sit",
          "zip"
        ],
        "lines": [
          {
            "who": "narrator",
            "text": "Sit, sit, sit!",
            "audio": "b2_u07_l8",
            "ko": "앉아요, 앉아요, 앉아요!"
          },
          {
            "who": "grumble",
            "text": "Shh... Can I sit?",
            "audio": "b2_u07_l9",
            "ko": "쉿… 나도 앉아도 돼?"
          },
          {
            "who": "pip",
            "text": "Piz... zip! Sit!",
            "audio": "b2_u07_l10",
            "ko": "피즈… 집! 싯! (지퍼! 앉아!)"
          }
        ],
        "ko": "모두 돌 위에 나란히 앉았어요. 그럼블이 처음으로 끝자리에 앉아요. 핍이 \"집! 싯!\" 하고 바로 말해요.",
        "ask": [
          {
            "en": "Where is Grumble sitting?",
            "ko": "그럼블은 어디 앉았어?"
          },
          {
            "en": "How many friends sit?",
            "ko": "몇 명이 앉았어?"
          }
        ]
      }
    ],
    "synopsis_ko": "추운 바람에 헤지 재킷 지퍼가 걸리고 쭉 찢어졌어요. 비즈가 z-i-p 을 꿰자 지퍼가 저절로! 소풍에서 번 입술에 소스가 묻고, 고양이는 구급상자에 앉고, 복숭아씨를 쳐요. 그럼블이 처음으로 친구들 옆에 앉아요.",
    "so_far_ko": "커다란 돼지를 건너게 했어요. 돼지가 트로피를 받았어요.",
    "goal_ko": "-ip·-it 단어를 읽고 그럼블과 나란히 앉아요."
  },
