  "story": {
    "title": "The Word Show",
    "bgm": "b2_u12_story",
    "panels": [
      {
        "id": "scene_b2_u12_1",
        "desc": "Grand finale on the Word Pond at golden sunset: a round stage of big lily pads floats in the middle of the pond with the finished bridge of stepping stones leading to it, every stone glowing softly. Pip stands at the front of the stage singing with its beak wide open and golden notes streaming up; Grumble sits beside it beating the red pot like a drum with two spoons, grinning, his lantern hanging above the stage like a bright star; Beads stands on a tall reed conducting with a string of rainbow beads; Bun and Hedgie dance on either side. All the animal friends (the cat, the pig, the dog, the fox, the ox, the pup, the ten hens) clap from the stones and the banks. Paper lanterns and petals everywhere.",
        "hidden": [],
        "lines": [
          {
            "who": "narrator",
            "text": "Look! The Word Show!",
            "audio": "b2_u12_l1"
          },
