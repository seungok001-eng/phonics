    "recap": [
      {
        "unit": 0,
        "scene": "scene_b2_u00_2",
        "line": {
          "who": "beads",
          "text": "Click-clack! Hi, Pip!",
          "audio": "b2_u00_l5",
          "ko": "딸깍딸깍! 안녕, 핍!"
        },
        "ko": "친구들이 단어 연못에 닿아 비즈를 만났어요."
      },
      {
        "unit": 1,
        "scene": "scene_b2_u01_1",
        "line": {
          "who": "pip",
          "text": "Tac! Tac?",
          "audio": "b2_u01_l2",
          "ko": "탁! 탁?"
        },
        "ko": "핍은 \"캣\"을 거꾸로 \"탁!\" 비즈가 첫 징검돌을 만들었어요."
      },
      {
        "unit": 2,
        "scene": "scene_b2_u02_4",
        "line": {
          "who": "grumble",
          "text": "Shh! It is my cap!",
          "audio": "b2_u02_l9",
          "ko": "쉿! 내 모자야!"
        },
        "ko": "떠내려간 모자를 되찾았는데 그럼블이 쓰고 있었어요!"
      },
      {
        "unit": 3,
        "scene": "scene_b2_u03_4",
        "line": {
          "who": "pip",
          "text": "Net? Ten? Net!",
          "audio": "b2_u03_l9",
          "ko": "넷? 텐? 넷! (그물!)"
        },
        "ko": "암탉 열 마리! 핍이 \"넷\"을 바로 말했어요."
      },
      {
        "unit": 4,
        "scene": "scene_b2_u04_4",
        "line": {
          "who": "grumble",
          "text": "Shh... It is my bed?",
          "audio": "b2_u04_l9",
          "ko": "쉿… 이거 내 침대야?"
        },
        "ko": "다리 다친 그럼블에게 침대를 만들어 줬어요."
      },
      {
        "unit": 5,
        "scene": "scene_b2_u05_3",
        "line": {
          "who": "pip",
          "text": "Cat! Cat! CAT!",
          "audio": "b2_u05_l7",
          "ko": "캣! 캣! 캣! (고양이!)"
        },
        "ko": "핍의 첫 단어 \"캣!\""
      },
      {
        "unit": 6,
        "scene": "scene_b2_u06_4",
        "line": {
          "who": "both",
          "text": "The pig can win!",
          "audio": "b2_u06_l8",
          "ko": "돼지가 이길 수 있어!"
        },
        "ko": "커다란 돼지가 큰 돌을 건너 이겼어요."
      },
      {
        "unit": 7,
        "scene": "scene_b2_u07_4",
        "line": {
          "who": "grumble",
          "text": "Shh... Can I sit?",
          "audio": "b2_u07_l9",
          "ko": "쉿… 나도 앉아도 돼?"
        },
        "ko": "그럼블이 처음으로 친구들 옆에 앉았어요."
      },
      {
        "unit": 8,
        "scene": "scene_b2_u08_3",
        "line": {
          "who": "grumble",
          "text": "Shh... Go to the dot.",
          "audio": "b2_u08_l7",
          "ko": "쉿… 불빛 쪽으로 와."
        },
        "ko": "안개 속 등불을 따라갔어요."
      },
      {
        "unit": 9,
        "scene": "scene_b2_u09_4",
        "line": {
          "who": "grumble",
          "text": "Shh... I like it.",
          "audio": "b2_u09_l9",
          "ko": "쉿… 나 이거 좋아."
        },
        "ko": "여우에게서 상자를 되찾고 그럼블이 웃었어요."
      },
      {
        "unit": 10,
        "scene": "scene_b2_u10_4",
        "line": {
          "who": "narrator",
          "text": "Pip can sing!",
          "audio": "b2_u10_l9",
          "ko": "핍이 노래해요!"
        },
        "ko": "다리가 완성되고 핍이 노래했어요."
      },
      {
        "unit": 11,
        "scene": "scene_b2_u11_4",
        "line": {
          "who": "narrator",
          "text": "Sh... sh... Sh... sh...",
          "audio": "b2_u11_l10",
          "ko": "쉬… 쉬… 쉬… 쉬…"
        },
        "ko": "숲에서 같은 소리가 두 번 들렸어요."
      }
    ],
    "certificate": {
