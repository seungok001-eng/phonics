  "show": {
    "song": {
      "title": "Pip's Word Song",
      "bgm": "song_backing",
      "lines": [
        {
          "text": "A, a, /æ/! Short a!",
          "audio": "b2_u12_s01"
        },
        {
          "text": "Cat, hat, bat, mat, rat!",
          "audio": "b2_u12_s02"
        },
        {
          "text": "Can, fan, pan, van!",
          "audio": "b2_u12_s03"
        },
        {
          "text": "Cap, map, nap, tap!",
          "audio": "b2_u12_s04"
        },
        {
          "text": "Bag, tag, rag, wag!",
          "audio": "b2_u12_s05"
        },
        {
          "text": "E, e, /e/! Short e!",
          "audio": "b2_u12_s06"
        },
        {
          "text": "Net, pet, wet, jet, vet!",
          "audio": "b2_u12_s07"
        },
        {
          "text": "Hen, pen, ten, den!",
          "audio": "b2_u12_s08"
        },
        {
          "text": "Bed, red, fed! Leg, peg, beg!",
          "audio": "b2_u12_s09"
        },
        {
          "text": "I, i, /ɪ/! Short i!",
          "audio": "b2_u12_s10"
        },
        {
          "text": "Pig, big, dig, wig, fig!",
          "audio": "b2_u12_s11"
        },
        {
          "text": "Pin, fin, bin, win, tin!",
          "audio": "b2_u12_s12"
        },
        {
          "text": "Zip, lip, dip, rip!",
          "audio": "b2_u12_s13"
        },
        {
          "text": "Sit, hit, kit, pit!",
          "audio": "b2_u12_s14"
        },
        {
          "text": "O, o, /ɑ/! Short o!",
          "audio": "b2_u12_s15"
        },
        {
          "text": "Dog, log, fog!",
          "audio": "b2_u12_s16"
        },
        {
          "text": "Pot, hot, dot, cot!",
          "audio": "b2_u12_s17"
        },
        {
          "text": "Top, hop, mop, pop!",
          "audio": "b2_u12_s18"
        },
        {
          "text": "Box, fox, ox!",
          "audio": "b2_u12_s19"
        },
        {
          "text": "U, u, /ʌ/! Short u!",
          "audio": "b2_u12_s20"
        },
        {
          "text": "Bug, hug, mug, rug!",
          "audio": "b2_u12_s21"
        },
        {
          "text": "Sun, run, bun, fun!",
          "audio": "b2_u12_s22"
        },
        {
          "text": "Cup, pup, up!",
          "audio": "b2_u12_s23"
        },
        {
          "text": "Click-clack! We can read!",
          "audio": "b2_u12_s24"
        },
        {
          "text": "A, e, i, o, u!",
          "audio": "b2_u12_s25"
        },
        {
          "text": "Pip can read! La la la!",
          "audio": "b2_u12_s26"
        }
      ]
