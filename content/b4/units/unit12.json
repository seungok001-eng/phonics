  "story": {
    "title": "The Song Tree Show",
    "bgm": "bgm_finale",
    "panels": [
      {
        "id": "scene_b4_u12_1",
        "desc": "Grand series finale at the Song Tree at golden sunset: the giant tree is in full bloom and glowing, its branches full of colorful flowers, lanterns and swirling golden notes, and a round stage is made from its big roots. Pip stands at the front of the stage singing with its beak wide open, golden notes streaming up; Grumble sits beside it beating his little drum with two sticks, grinning, his lantern hanging from a branch like a star; Fairy E twirls above them showering sparkles from her star wand; Beads stands on a root conducting with a string of rainbow beads; Bun and Hedgie dance on either side. All the animal friends from the whole journey clap and sing around the hill: the cat, the pig, the fox, the goat in its red coat, the mule, the bear cub, the seal, the sheep, the jay, the crow, the little mouse and the twin bluebirds Pim and Pam (two tiny sky-blue birds always side by side, one with a small red feather tuft and one with a small yellow feather tuft). Petals and confetti everywhere. No letters anywhere.",
        "hidden": [],
        "lines": [
          {
            "who": "narrator",
            "text": "Look! The Song Tree Show!",
            "audio": "b4_u12_l1",
            "ko": "봐요! 노래 나무 쇼예요!"
          },
          {
            "who": "both",
            "text": "We can read! We can sing!",
            "audio": "b4_u12_l2",
            "ko": "우리는 읽을 수 있어요! 노래할 수 있어요!"
          },
          {
            "who": "fairy",
            "text": "Eee! Cape, kite, rope, cube!",
            "audio": "b4_u12_l3",
            "ko": "이~! 망토, 연, 밧줄, 블록!"
          }
        ],
        "ko": "노래 나무 뿌리 무대에서 핍이 노래하고 그럼블이 북을 둥둥, 요정 이는 반짝반짝, 비즈는 지휘, 번과 헤지는 춤을 춰요. 1~4권의 동물 친구들이 모두 모였어요.",
        "ask": [
          {
            "en": "Who is on the stage?",
            "ko": "무대에 누가 있어?"
          },
          {
            "en": "What does Grumble play?",
            "ko": "그럼블은 뭘 연주해?"
          }
        ]
      }
    ],
    "synopsis_ko": "노래 나무 아래에서 시리즈 마지막 공연이 열려요. 핍이 노래하고 그럼블이 북을 치고, 요정 이가 반짝이를 뿌려요. 1~4권에서 만난 동물 친구들이 모두 모여 함께 노래해요.",
    "so_far_ko": "노래 나무가 다시 노래했어요. 모두 함께 주제가를 부르고 그럼블은 북을 쳤어요.",
    "goal_ko": "노래 나무 노래를 부르고, 4권 이야기를 되짚고, 시리즈 수료증을 받아요."
  },
