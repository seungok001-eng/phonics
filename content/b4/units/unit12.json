    "song": {
      "title": "The Song Tree Song",
      "bgm": "song_backing",
      "lines": [
        {
          "text": "Add an e! Eee! Eee!",
          "audio": "b4_u12_s01"
        },
        {
          "text": "Cap, cape! Can, cane!",
          "audio": "b4_u12_s02"
        },
        {
          "text": "Cake, gate, lake, snake!",
          "audio": "b4_u12_s03"
        },
        {
          "text": "Kit, kite! Pin, pine!",
          "audio": "b4_u12_s04"
        },
        {
          "text": "Bike, five, hive, slide!",
          "audio": "b4_u12_s05"
        },
        {
          "text": "Hop, hope! Not, note!",
          "audio": "b4_u12_s06"
        },
        {
          "text": "Rope, bone, rose, stone!",
          "audio": "b4_u12_s07"
        },
        {
          "text": "Cub, cube! Tub, tube!",
          "audio": "b4_u12_s08"
        },
        {
          "text": "A cute mule! A flute!",
          "audio": "b4_u12_s09"
        },
        {
          "text": "Two make one! Click-clack!",
          "audio": "b4_u12_s10"
        },
        {
          "text": "Rain, train, tail, sail!",
          "audio": "b4_u12_s11"
        },
        {
          "text": "Day, play, tray, hay!",
          "audio": "b4_u12_s12"
        },
        {
          "text": "Tree, bee, feet, seed!",
          "audio": "b4_u12_s13"
        },
        {
          "text": "Sea, leaf, tea, seal!",
          "audio": "b4_u12_s14"
        },
        {
          "text": "Boat, goat, soap, coat!",
          "audio": "b4_u12_s15"
        },
        {
          "text": "Snow, bowl, crow! Go slow!",
          "audio": "b4_u12_s16"
        },
        {
          "text": "Moon, boot, roof, broom!",
          "audio": "b4_u12_s17"
        },
        {
          "text": "House, mouse, cloud, mouth!",
          "audio": "b4_u12_s18"
        },
        {
