    "recap": [
      {
        "unit": 0,
        "scene": "scene_b4_u00_2",
        "line": {
          "who": "fairy",
          "text": "Eee! Hi, Pip!",
          "audio": "b4_u00_l5",
          "ko": "이~! 안녕, 핍!"
        },
        "ko": "친구들이 마법 성에 닿아 요정 이를 만났어요."
      },
      {
        "unit": 1,
        "scene": "scene_b4_u01_1",
        "line": {
          "who": "pip",
          "text": "Cap... e? Cap-e!",
          "audio": "b4_u01_l2",
          "ko": "캡… 이? 캡-이!"
        },
        "ko": "핍은 \"캡-이!\" 하고 끊어 읽었어요. 요정 이가 모자를 망토로 바꿨어요."
      },
      {
        "unit": 2,
        "scene": "scene_b4_u02_4",
        "line": {
          "who": "grumble",
          "text": "Shh! Hide! Hide!",
          "audio": "b4_u02_l10",
          "ko": "쉿! 숨어! 숨어!"
        },
        "ko": "벌집에서 벌이 나오자 그럼블이 \"숨어!\" 하고 알려 줬어요."
      },
      {
        "unit": 3,
        "scene": "scene_b4_u03_3",
        "line": {
          "who": "grumble",
          "text": "Shh... Take the rope.",
          "audio": "b4_u03_l6",
          "ko": "쉿… 밧줄 잡아."
        },
        "ko": "그럼블이 창문에서 밧줄을 내려 줬어요."
      },
      {
        "unit": 4,
        "scene": "scene_b4_u04_2",
        "line": {
          "who": "narrator",
          "text": "The tub is a tube!",
          "audio": "b4_u04_l4",
          "ko": "욕조가 튜브가 됐어요!"
        },
        "ko": "욕조가 튜브가 되어 모두 미끄러져 내려갔어요."
      },
      {
        "unit": 5,
        "scene": "scene_b4_u05_3",
        "line": {
          "who": "pip",
          "text": "Cape! Cape! CAPE!",
          "audio": "b4_u05_l7",
          "ko": "케이프! 케이프! 케이프! (망토!)"
        },
        "ko": "핍의 첫 마법 단어 \"케이프!\""
      },
      {
        "unit": 6,
        "scene": "scene_b4_u06_3",
        "line": {
          "who": "bun",
          "text": "We ride the train!",
          "audio": "b4_u06_l6",
          "ko": "우리 기차 탄다!"
        },
        "ko": "비를 그치고 커다래진 기차를 타고 달렸어요."
      },
      {
        "unit": 7,
        "scene": "scene_b4_u07_3",
        "line": {
          "who": "grumble",
          "text": "Shh... Tea? I like tea.",
          "audio": "b4_u07_l7",
          "ko": "쉿… 차 마실래? 난 차가 좋아."
        },
        "ko": "그럼블이 차를 가져와 함께 마셨어요."
      },
      {
        "unit": 8,
        "scene": "scene_b4_u08_3",
        "line": {
          "who": "pip",
          "text": "Goat! A goat in a coat!",
          "audio": "b4_u08_l8",
          "ko": "염소! 외투 입은 염소!"
        },
        "ko": "외투 입은 염소와 배를 타고 해자를 건넜어요."
      },
      {
        "unit": 9,
        "scene": "scene_b4_u09_4",
        "line": {
          "who": "grumble",
          "text": "Shh... Sit. Look at the moon.",
          "audio": "b4_u09_l9",
          "ko": "쉿… 앉아. 달 좀 봐."
        },
        "ko": "옥상 소파에서 그럼블과 함께 달을 봤어요."
      },
      {
        "unit": 10,
        "scene": "scene_b4_u10_3",
        "line": {
          "who": "narrator",
          "text": "Pip can sing more!",
          "audio": "b4_u10_l7",
          "ko": "핍이 더 많이 노래할 수 있어요!"
        },
        "ko": "하프에서 노래 조각 넷이 나와 핍에게 들어갔어요."
      },
      {
        "unit": 11,
        "scene": "scene_b4_u11_3",
        "line": {
          "who": "both",
          "text": "Pop! Pop! Phonics!",
          "audio": "b4_u11_l9",
          "ko": "팝! 팝! 파닉스!"
        },
        "ko": "노래 나무가 다시 노래하고 모두 함께 불렀어요."
      }
    ],
