    "recap": [
      {
        "unit": 0,
        "scene": "scene_b3_u00_2",
        "line": {
          "who": "twins",
          "text": "Together! Hi, Pip!",
          "audio": "b3_u00_l5",
          "ko": "함께! 안녕, 핍!"
        },
        "ko": "숲에서 쌍둥이 파랑새 핌과 팜을 만났어요."
      },
      {
        "unit": 1,
        "scene": "scene_b3_u01_2",
        "line": {
          "who": "grumble",
          "text": "SHH!",
          "audio": "b3_u01_l5",
          "ko": "쉬잇!"
        },
        "ko": "그럼블의 \"쉿!\"이 바로 sh 소리라서 첫 번째 문이 열렸어요."
      },
      {
        "unit": 2,
        "scene": "scene_b3_u02_2",
        "line": {
          "who": "twins",
          "text": "Together! /tʃ/ /tʃ/ chip!",
          "audio": "b3_u02_l4",
          "ko": "함께! /tʃ/ /tʃ/ 감자칩!"
        },
        "ko": "점심 도둑 다람쥐를 찾고 감자칩을 나눠 먹었어요."
      },
      {
        "unit": 3,
        "scene": "scene_b3_u03_4",
        "line": {
          "who": "grumble",
          "text": "Shh... This bath is hot.",
          "audio": "b3_u03_l9",
          "ko": "쉿… 이 목욕물 따뜻하네."
        },
        "ko": "진흙에 빠진 그럼블에게 거품 목욕을 해 줬어요."
      },
      {
        "unit": 4,
        "scene": "scene_b3_u04_4",
        "line": {
          "who": "narrator",
          "text": "The king can sing a song!",
          "audio": "b3_u04_l9",
          "ko": "왕이 노래를 불러요!"
        },
        "ko": "양말 속 반지를 찾아 주자 오리 왕이 노래했어요."
      },
      {
        "unit": 5,
        "scene": "scene_b3_u05_3",
        "line": {
          "who": "pip",
          "text": "Sh! Sh! SH!",
          "audio": "b3_u05_l8",
          "ko": "쉬! 쉬! 쉬이! (sh!)"
        },
        "ko": "핍의 첫 짝꿍 소리 \"sh!\""
      },
      {
        "unit": 6,
        "scene": "scene_b3_u06_4",
        "line": {
          "who": "grumble",
          "text": "Shh! ...Clap, clap.",
          "audio": "b3_u06_l10",
          "ko": "쉿! …짝, 짝."
        },
        "ko": "시계를 고치자 그럼블이 몰래 손뼉을 쳤어요."
      },
      {
        "unit": 7,
        "scene": "scene_b3_u07_4",
        "line": {
          "who": "grumble",
          "text": "Shh! Not the drum!",
          "audio": "b3_u07_l10",
          "ko": "쉿! 북은 안 돼!"
        },
        "ko": "아기 새가 태어나고 그럼블이 등불을 걸어 줬어요."
      },
      {
        "unit": 8,
        "scene": "scene_b3_u08_4",
        "line": {
          "who": "twins",
          "text": "Two for Grumble! Together!",
          "audio": "b3_u08_l10",
          "ko": "그럼블은 두 개! 함께!"
        },
        "ko": "그네로 시내를 건너 그럼블과 간식을 나눴어요."
      },
      {
        "unit": 9,
        "scene": "scene_b3_u09_4",
        "line": {
          "who": "grumble",
          "text": "Shh! I said shh! Ha, ha!",
          "audio": "b3_u09_l10",
          "ko": "쉿! \"쉿\" 하랬지! 하하!"
        },
        "ko": "침팬지에게 램프를 주고 등불을 되찾았어요."
      },
      {
        "unit": 10,
        "scene": "scene_b3_u10_4",
        "line": {
          "who": "narrator",
          "text": "Pip can sing the song!",
          "audio": "b3_u10_l10",
          "ko": "핍이 노래해요!"
        },
        "ko": "핍이 마지막 문을 열고 노래 조각 셋을 찾았어요."
      },
      {
        "unit": 11,
        "scene": "scene_b3_u11_4",
        "line": {
          "who": "hedgie",
          "text": "Cap? It is not cap!",
          "audio": "b3_u11_l11",
          "ko": "캡? 캡이 아니야!"
        },
        "ko": "숲 끝에서 단어가 바뀌는 성문을 봤어요."
      }
    ],
