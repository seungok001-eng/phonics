  "story": {
    "title": "The Forest Show",
    "bgm": "bgm_finale",
    "panels": [
      {
        "id": "scene_b3_u12_1",
        "desc": "Grand finale in the Pair Forest at golden sunset: a round stage made of black wooden blocks stands in the glade behind the last door, with strings of little flags and glowing lamps overhead and the open round doors of the forest glowing along the path behind. Pip stands at the front of the stage singing with its beak wide open and golden notes streaming up; Pim and Pam sing side by side next to Pip; Grumble sits beside them beating the crab's drum with two sticks, grinning, his lantern hanging above the stage like a bright star; Beads stands on a tall stick conducting with a string of rainbow beads; Bun and Hedgie dance on either side. All the forest friends clap from the grass: the three chipmunks, the Duck King and his ducks, the crab, the chimp with its little lamp, the moth and the fluffy baby bird. Far away on a hill, a castle gate glows softly.",
        "hidden": [],
        "lines": [
          {
            "who": "narrator",
            "text": "Look! The Forest Show!",
            "audio": "b3_u12_l1",
            "ko": "봐요! 숲 공연이에요!"
          },
          {
            "who": "twins",
            "text": "Together! Sh, ch, th!",
            "audio": "b3_u12_l2",
            "ko": "함께! 쉬, 치, 스!"
          },
          {
            "who": "both",
            "text": "We can read! Hooray!",
            "audio": "b3_u12_l3",
            "ko": "우리는 읽을 수 있어요! 만세!"
          }
        ],
        "ko": "노을 진 풀밭, 까만 블록 무대에서 핍이 노래하고 핌과 팜이 함께 불러요. 그럼블은 게의 북을 둥둥, 비즈는 지휘해요. 숲 친구들이 모두 손뼉을 치고, 저 멀리 성문이 은은하게 빛나요.",
        "ask": [
          {
            "en": "Who is on the stage?",
            "ko": "무대에 누가 있어?"
          },
          {
            "en": "What is far away?",
            "ko": "저 멀리 뭐가 보여?"
          }
        ]
      }
    ],
    "synopsis_ko": "마지막 문 너머 풀밭의 블록 무대에서 숲 공연이 열려요. 핍과 핌·팜이 짝꿍 노래를 부르고 그럼블이 북을 쳐요. 숲 친구들이 모두 손뼉을 쳐요. 저 멀리 성문이 빛나요.",
    "so_far_ko": "숲 파티에서 그럼블이 북을 쳤고, 숲 끝에서 단어가 바뀌는 성문을 봤어요.",
    "goal_ko": "짝꿍 노래를 부르고, 이야기를 되짚고, 수료증을 받아요."
  },
