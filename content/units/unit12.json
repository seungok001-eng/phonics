  "story": {
    "title": "The Alphabet Show",
    "bgm": "u12_story",
    "panels": [
      {
        "id": "scene_u12_1",
        "desc": "Grand finale on a stage made of giant flowers in the middle of the blooming Sound Garden at golden sunset. Pip stands at the front of the petal stage with its beak wide open, singing, golden music notes and sparkles streaming into the sky. Beside it Grumble sits beating a small drum with two sticks, grinning, his lantern hanging above the stage shining like a star. Bun and Hedgie dance on either side with arms up. All twenty-six letter trees stand in a wide circle around the stage, every tree glowing softly and heavy with fruit, with the animal friends (the queen swan, the panda, the zebra, the yak, the otter, the monkey) clapping in front of them. Blossom petals drift everywhere.",
        "hidden": [],
        "lines": [
          {
            "who": "narrator",
            "text": "Look! The Alphabet Show!",
            "audio": "u12_l1"
          },
          {
            "who": "both",
            "text": "We can sing A to Z!",
            "audio": "u12_l2"
          },
          {
            "who": "grumble",
            "text": "Boom! Boom! I like it!",
            "audio": "u12_l3"
          }
        ]
      }
